{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/*.css", "/*.js", "/favicon.ico"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**", "!/**/*.html"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-exercises",
      "urls": ["/api/exercises", "/api/exercises/**"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 100,
        "maxAge": "1d",
        "timeout": "1s"
      }
    },
    {
      "name": "api-workout-sessions",
      "urls": ["/api/workout-sessions", "/api/workout-sessions/**", "/api/workout-sessions?**"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 200,
        "maxAge": "1d",
        "timeout": "1s"
      }
    }
  ]
}
