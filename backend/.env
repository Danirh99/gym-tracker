# Defaults NO sensibles. En produccion, las variables reales (APP_SECRET, etc.)
# vienen del entorno y machacan estos valores. Ver docker-compose.yml.

APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me-in-env

# Conexion por defecto al Postgres del docker-compose. La URL real puede
# venir de la variable de entorno DATABASE_URL en tiempo de ejecucion.
DATABASE_URL="postgresql://app:app@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
